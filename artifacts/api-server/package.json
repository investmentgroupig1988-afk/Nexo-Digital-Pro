{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./build.mjs && node --enable-source-maps ./dist/index.mjs",
    "build": "node ./build.mjs && node ../../scripts/verify-api-dist.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "analyze:signals": "tsx src/scripts/analyze-signal-engine.ts",
    "analyze:signals:v2": "tsx src/scripts/analyze-signal-v2.ts",
    "analyze:signals:v3": "tsx src/scripts/analyze-signal-v3.ts",
    "analyze:signals:v4": "tsx src/scripts/analyze-signal-v4.ts",
    "analyze:signals:v5": "tsx src/scripts/analyze-signal-v5.ts",
    "analyze:signals:v6": "tsx src/scripts/analyze-signal-v6.ts",
    "analyze:signals:v7": "tsx src/scripts/analyze-signal-v7.ts",
    "analyze:signals:v8": "tsx src/scripts/analyze-signal-v8.ts",
    "analyze:signals:v9": "tsx src/scripts/analyze-signal-v9.ts",
    "analyze:signals:v10": "tsx src/scripts/analyze-signal-v10.ts",
    "research:v9:hash": "tsx src/scripts/print-signal-v9-hash.ts",
    "research:v10:hash": "tsx src/scripts/print-signal-v10-hash.ts",
    "research:v11:hash": "tsx src/scripts/print-signal-v11-hash.ts",
    "research:v6:hash": "tsx src/scripts/print-signal-v6-hash.ts",
    "test:v6": "tsx --test src/services/signal-backtest.test.ts src/services/signal-research-dataset.test.ts src/services/signal-strategy-v6-snapshot.test.ts src/services/signal-strategy-v6.test.ts src/services/signal-strategy-v6-ablation.test.ts",
    "test:v7": "tsx --test src/services/signal-strategy-v7-snapshot.test.ts src/services/signal-strategy-v7.test.ts",
    "test:v8": "tsx --test src/services/signal-strategy-v8.test.ts",
    "test:v9": "tsx --test src/services/signal-strategy-v9.test.ts",
    "test:v10": "tsx --test src/services/signal-strategy-v10.test.ts",
    "test:v11": "tsx --test src/services/signal-strategy-v11.test.ts src/services/signal-shadow-research.test.ts",
    "research:validate:frozen-1h": "tsx src/scripts/validate-frozen-1h-hypothesis.ts",
    "research:forward:btc-1h": "tsx src/scripts/validate-frozen-1h-hypothesis.ts --forward-btc --write-ledger",
    "research:robustness:btc-1h": "tsx src/scripts/analyze-frozen-1h-btc-robustness.ts",
    "typecheck": "node ../../scripts/typecheck-api-server.mjs",
    "test": "tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/product": "workspace:*",
    "axios": "^1.19.0",
    "better-auth": "^1.7.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "pg": "^8.22.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "esbuild": "0.28.1",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0",
    "tsx": "catalog:"
  }
}
