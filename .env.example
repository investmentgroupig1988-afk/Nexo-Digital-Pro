# API server
# Required only for XAU/USD endpoints. Keep this server-side; never prefix it with VITE_.
TWELVEDATA_API_KEY=

# Optional. Defaults to 5000 for local development.
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
RATE_LIMIT_MAX=120

# Comma-separated browser origins allowed to call a separately hosted API.
# Same-origin requests need no CORS configuration. This is the preferred name;
# CORS_ORIGINS remains a backwards-compatible alias for older environments.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Railway sits behind one reverse-proxy hop in production. Keep 0 locally.
TRUST_PROXY_HOPS=0

# Frontend (public, never use these variables for secrets). Local development
# uses Vite's /api proxy by default. Set this only when the browser must call a
# separately hosted public API, for example https://api.example.com.
VITE_API_BASE_URL=

# Optional local Vite settings. They are not used by a production build.
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_PORT=5173

# Deployment examples (replace placeholders only in provider dashboards):
# Railway staging: NODE_ENV=production
# Railway staging: CORS_ALLOWED_ORIGINS=https://<frontend-staging>.vercel.app
# Vercel staging: VITE_API_BASE_URL=https://<backend-staging>.up.railway.app
# Production: use the corresponding HTTPS frontend and backend origins.
# Never place TWELVEDATA_API_KEY or any backend credential in a VITE_* variable.

# Optional credentials used only by scripts/market-quotes, never by the API server.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
OPENAI_API_KEY=

# Not currently required by the API. Reserve it for a future persistence feature only.
# DATABASE_URL=postgres://user:password@localhost:5432/nexo_digital_pro
