# Server runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY_HOPS=0

# Comma-separated browser origins. Use exact origins only, without a path.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL and authentication. Required to enable registration, login, the
# private panel and administration. Do not expose any of these in Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Leave the domain empty locally. In production, use a shared parent domain
# only when frontend and API use one (for example .example.com).
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax

# Optional server-only Telegram V1. All three values are required to enable it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_PUBLIC_URL=https://staging.nexodigitalpro.lat/

# Server-only provider credential. XAUUSD is unavailable without a valid key.
TWELVEDATA_API_KEY=

# Keep false until the owner supplies and verifies every official Argentina
# destination value. This server-side gate cannot be bypassed from the browser.
ARGENTINA_PAYMENTS_ENABLED=false

# Public frontend configuration. Local Vite uses its /api proxy by default.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_PORT=5173

# Optional public destination details for Argentina. Leave blank until the
# owner supplies official values; the UI remains disabled without them.
VITE_PAYMENT_ALIAS=
VITE_PAYMENT_CBU_CVU=
VITE_PAYMENT_HOLDER=

# Used only by `corepack pnpm run admin:bootstrap` after an account exists.
# Set this temporarily in the shell or deployment dashboard; do not commit it.
ADMIN_EMAIL=

# Optional, isolated market-quote utilities. They are never read by the API or
# the browser bundle.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
