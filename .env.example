# Server runtime
NODE_ENV=development
PORT=5000
LOG_LEVEL=info
RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_MAX=10
TRUST_PROXY_HOPS=0

# Comma-separated browser origins. Use exact origins only, without a path.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# PostgreSQL and authentication. Required to enable registration, login, the
# private panel and administration. Do not expose any of these in Vercel.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000

# Leave the domain empty locally. In production, use a shared parent domain
# only when frontend and API use one (for example .example.com).
AUTH_COOKIE_DOMAIN=
AUTH_COOKIE_SAME_SITE=lax

# Optional server-only Telegram V1. All three values are required to enable it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFICATION_PUBLIC_URL=https://staging.trenoro.com/

# Optional server-only provider credential for isolated quote utilities.
# XAUUSD remains blocked at the commercial API boundary regardless of this key.
TWELVEDATA_API_KEY=

# Keep both false until staging has passed the complete manual payment flow.
# The server-side gate remains authoritative even if the browser flag changes.
ARGENTINA_PAYMENTS_ENABLED=false
VITE_ARGENTINA_PAYMENTS_ENABLED=false

# Public frontend configuration. Local Vite uses its /api proxy by default.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:5000
VITE_PORT=5173

# Password reset and email verification. Keep server secrets out of Vercel.
RESEND_API_KEY=
AUTH_EMAIL_FROM=
APP_PUBLIC_URL=http://localhost:5173

# Official legal identity for the server-side launch-readiness check. TRENORO
# is a trade name operated by this human person, not a separate legal entity.
LEGAL_OPERATOR_NAME=
LEGAL_TAX_ID=
LEGAL_ADDRESS=
SUPPORT_EMAIL=
LEGAL_EMAIL=
SUPPORT_WHATSAPP_NUMBER=

# Public copies required by the separately deployed Vite frontend. Keep them
# empty until the official identity is supplied; never publish placeholders.
VITE_SUPPORT_WHATSAPP_NUMBER=
VITE_LEGAL_OPERATOR_NAME=
VITE_LEGAL_TAX_ID=
VITE_LEGAL_ADDRESS=
VITE_SUPPORT_EMAIL=
VITE_LEGAL_EMAIL=

# Used only by `corepack pnpm run admin:bootstrap` after an account exists.
# Set this temporarily in the shell or deployment dashboard; do not commit it.
ADMIN_EMAIL=

# Optional, isolated market-quote utilities. They are never read by the API or
# the browser bundle.
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
