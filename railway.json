{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "railpack",
    "buildCommand": "corepack pnpm --filter @workspace/api-server run build"
  },
  "deploy": {
    "startCommand": "corepack pnpm db:migrate && corepack pnpm --filter @workspace/api-server run start",
    "healthcheckPath": "/api/healthz",
    "healthcheckTimeout": 100,
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10
  }
}
